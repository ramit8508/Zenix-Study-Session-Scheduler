{
  "name": "zenix-study-tracker",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "author": "Your Name",
  "description": "Zenix Study Tracker - Desktop App",
  "homepage": "https://github.com/ramit8508/Zenix-Study-Session-Scheduler",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.zenix.studytracker",
    "productName": "Zenix Study Tracker",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../Backend",
        "to": "Backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        "deb"
      ],
      "extraFiles": [
        {
          "from": "node_modules/sqlite3",
          "to": "node_modules/sqlite3",
          "filter": [
            "**/*"
          ]
        }
      ],
      "category" : "Education",
      "executableName": "zenix-study-tracker",
      "synopsis": "Fully offline study session tracking application",
      "maintainer": "Student OS Team",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "protocols": [],
    "beforePack": "./scripts/before-pack.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.11.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
